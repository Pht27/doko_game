#!/bin/bash
# Nightly staging DB reset: clones prod (doko_analog) → staging (doko_analog_staging).
# backend-staging is stopped during the operation and restarted afterwards.
set -euo pipefail

COMPOSE="{{ app_path }}/Code/infrastructure/docker-compose.yml"

docker compose -f "$COMPOSE" stop backend-staging

# Terminate any remaining connections to the staging DB
docker exec postgres psql -U doko_app -d postgres \
  -c "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = 'doko_analog_staging';"

docker exec postgres dropdb -U doko_app --if-exists doko_analog_staging
docker exec postgres createdb -U doko_app doko_analog_staging

docker exec postgres pg_dump -U doko_app doko_analog \
  | docker exec -i postgres psql -U doko_app doko_analog_staging

docker compose -f "$COMPOSE" start backend-staging
